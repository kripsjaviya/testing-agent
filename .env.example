# Copy to .env and fill in the key for whichever provider you plan to use.
# Only the selected provider's key is required (default provider: anthropic).

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (alternative: --provider gemini) ---
GEMINI_API_KEY=

# --- Optional overrides ---
# BUGFIXER_PROVIDER=anthropic
# BUGFIXER_MAX_COST_USD=5.00
